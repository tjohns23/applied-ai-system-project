# PawPal+ Environment Configuration
# Copy this file to .env and fill in your actual values

# OpenAI API Key
# Get your free key at: https://platform.openai.com/api_keys
# Start with free trial credits ($5 worth)
OPENAI_API_KEY=sk-proj-your-api-key-here-replace-with-actual-key

# Optional: Specify model (defaults to gpt-3.5-turbo)
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_MODEL=gpt-4

# Optional: Request rate limit (requests per minute)
# OPENAI_RATE_LIMIT=20
